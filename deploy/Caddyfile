# The public web server on the VM (compose.vm.yml): Let's Encrypt certificate for $TT_HOST, the web app with an SPA
# fallback, and WebSocket upgrades proxied to the relay's HTTPS listener (the fallback for networks without UDP).
{
	servers {
		protocols h1 h2
	}
}

{$TT_HOST} {
	@ws header Connection *Upgrade*
	handle @ws {
		reverse_proxy https://relay:8443 {
			transport http {
				tls_server_name {$TT_HOST}
			}
		}
	}

	handle /healthz {
		header Content-Type text/plain
		respond "ok" 200
	}

	handle {
		# Same origin for everything, so cross-origin isolation costs nothing and gives the player SharedArrayBuffer.
		header Cross-Origin-Opener-Policy same-origin
		header Cross-Origin-Embedder-Policy require-corp
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
