# The public web server on the VM (compose.vm.yml): Let's Encrypt certificate for $TT_HOST, the web app with an SPA
# fallback, and WebSocket upgrades proxied to the relay's HTTPS listener (the fallback for networks without UDP).
{
	servers {
		protocols h1 h2
	}
}

{$TT_HOST} {
	@ws header Connection *Upgrade*
	handle @ws {
		reverse_proxy https://relay:8443 {
			transport http {
				tls_server_name {$TT_HOST}
			}
		}
	}

	# The track archive (wiki/howto/archive.md), for rewind: static files with range requests. Segments and images
	# never change once written; indexes and HLS playlists are revalidated by ETag.
	handle /archive/* {
		uri strip_prefix /archive
		root * /archive
		header Cross-Origin-Opener-Policy same-origin
		header Cross-Origin-Embedder-Policy require-corp
		header Cross-Origin-Resource-Policy same-origin
		@immutable path *.m4s *.mp4 *.jpg *.png
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@index path *.json *.jsonl *.m3u8
		header @index Cache-Control no-cache
		encode @index zstd gzip
		@playlist path *.m3u8
		header @playlist Content-Type application/vnd.apple.mpegurl
		@segment path *.m4s
		header @segment Content-Type video/iso.segment
		file_server {
			hide *.tmp
		}
	}

	handle /healthz {
		header Content-Type text/plain
		respond "ok" 200
	}

	handle {
		# Same origin for everything, so cross-origin isolation costs nothing and gives the player SharedArrayBuffer.
		header Cross-Origin-Opener-Policy same-origin
		header Cross-Origin-Embedder-Policy require-corp
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
