# moq-relay built from crates.io at a pinned version. Build: docker build -t talk-tracks-relay:0.17.8 -f Dockerfile.relay .
FROM rust:1.95-bookworm AS build
RUN cargo install moq-relay --version 0.17.8 --locked
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/cargo/bin/moq-relay /usr/local/bin/moq-relay
ENTRYPOINT ["moq-relay"]
