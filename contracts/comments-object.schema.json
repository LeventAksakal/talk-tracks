{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "description": "Where on a slide: a region, a text range, both (the range's box), or neither (the whole slide).",
      "properties": {
        "deck": {
          "description": "The deck track's group that holds the deck",
          "minimum": 0,
          "title": "Deck",
          "type": "integer"
        },
        "index": {
          "description": "The slide's 0-based position in its deck",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "region": {
          "anyOf": [
            {
              "$ref": "#/$defs/Region"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "span": {
          "anyOf": [
            {
              "description": "Spans of the slide's text runs, in reading order",
              "items": {
                "$ref": "#/$defs/RunSpan"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spans of the slide's text runs",
          "title": "Span"
        }
      },
      "required": [
        "deck",
        "index"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "Author": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable for one person in the room: given by the room service (listeners) or the console (speaker)",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Display name, no account",
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "speaker": {
          "default": false,
          "description": "The speaker: may erase, unmark or hide anyone's annotations",
          "title": "Speaker",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Author",
      "type": "object"
    },
    "Comment": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "at": {
          "description": "Room ms it was posted at; the record's m is when it appeared",
          "minimum": 0,
          "title": "At",
          "type": "integer"
        },
        "by": {
          "$ref": "#/$defs/Author"
        },
        "id": {
          "description": "Given by the room service, unique in the room",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "comment",
          "default": "comment",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "default": false,
          "description": "Asked as a question for the speaker",
          "title": "Question",
          "type": "boolean"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "at",
        "by",
        "text",
        "anchor"
      ],
      "title": "Comment",
      "type": "object"
    },
    "CommentEdit": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "$ref": "#/$defs/Author"
        },
        "id": {
          "description": "Given by the room service, unique in the room",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "edit",
          "default": "edit",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "by"
      ],
      "title": "CommentEdit",
      "type": "object"
    },
    "CommentHide": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "$ref": "#/$defs/Author"
        },
        "id": {
          "description": "Given by the room service, unique in the room",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "hide",
          "default": "hide",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "by"
      ],
      "title": "CommentHide",
      "type": "object"
    },
    "CommentRecord": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "discriminator": {
            "mapping": {
              "comment": "#/$defs/Comment",
              "edit": "#/$defs/CommentEdit",
              "hide": "#/$defs/CommentHide",
              "reply": "#/$defs/Reply"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Comment"
            },
            {
              "$ref": "#/$defs/Reply"
            },
            {
              "$ref": "#/$defs/CommentEdit"
            },
            {
              "$ref": "#/$defs/CommentHide"
            }
          ],
          "title": "Data"
        },
        "m": {
          "description": "Room ms when it took effect: posted, edited, hidden, or its slide shown again",
          "minimum": 0,
          "title": "M",
          "type": "integer"
        }
      },
      "required": [
        "m",
        "data"
      ],
      "title": "CommentRecord",
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "description": "A box on the slide, in fractions of it: x, y the top-left corner.",
      "properties": {
        "h": {
          "maximum": 1,
          "minimum": 0,
          "title": "H",
          "type": "number"
        },
        "w": {
          "maximum": 1,
          "minimum": 0,
          "title": "W",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "Region",
      "type": "object"
    },
    "Reply": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "description": "Room ms it was posted at; the record's m is when it appeared",
          "minimum": 0,
          "title": "At",
          "type": "integer"
        },
        "by": {
          "$ref": "#/$defs/Author",
          "description": "The speaker's replies are shown first"
        },
        "id": {
          "description": "Given by the room service, unique in the room",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "reply",
          "default": "reply",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "to": {
          "description": "The thread's comment",
          "minLength": 1,
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "id",
        "at",
        "to",
        "by",
        "text"
      ],
      "title": "Reply",
      "type": "object"
    },
    "RunSpan": {
      "additionalProperties": false,
      "description": "Characters [start, end) of one text run; the whole run by default.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One past the last character; none for the run's end",
          "title": "End"
        },
        "run": {
          "description": "Unique within its slide, e.g. t23",
          "maxLength": 32,
          "minLength": 1,
          "title": "Run",
          "type": "string"
        },
        "start": {
          "default": 0,
          "description": "First character in the run",
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "run"
      ],
      "title": "RunSpan",
      "type": "object"
    }
  },
  "description": "One object of the ``comments`` track (eventType ``com.talktracks.comments``).",
  "items": {
    "$ref": "#/$defs/CommentRecord"
  },
  "title": "CommentsObject",
  "type": "array"
}
