{
  "$defs": {
    "CaptionLine": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "id": {
          "description": "Rises with time: the start time in media ms (or one more than the previous id); stable across restarts and back-fill",
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "start_ms": {
          "description": "Media time of the first word",
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start_ms",
        "end_ms",
        "text"
      ],
      "title": "CaptionLine",
      "type": "object"
    },
    "CaptionsState": {
      "additionalProperties": false,
      "properties": {
        "interim": {
          "default": "",
          "title": "Interim",
          "type": "string"
        },
        "kind": {
          "const": "captions",
          "default": "captions",
          "title": "Kind",
          "type": "string"
        },
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/CaptionLine"
          },
          "title": "Lines",
          "type": "array"
        }
      },
      "required": [
        "lang",
        "lines"
      ],
      "title": "CaptionsState",
      "type": "object"
    },
    "Chapter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start_ms",
        "title",
        "summary"
      ],
      "title": "Chapter",
      "type": "object"
    },
    "GlossaryTerm": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "term": {
          "title": "Term",
          "type": "string"
        }
      },
      "required": [
        "term",
        "definition"
      ],
      "title": "GlossaryTerm",
      "type": "object"
    },
    "OutlineState": {
      "additionalProperties": false,
      "properties": {
        "chapters": {
          "items": {
            "$ref": "#/$defs/Chapter"
          },
          "title": "Chapters",
          "type": "array"
        },
        "glossary": {
          "items": {
            "$ref": "#/$defs/GlossaryTerm"
          },
          "title": "Glossary",
          "type": "array"
        },
        "kind": {
          "const": "outline",
          "default": "outline",
          "title": "Kind",
          "type": "string"
        },
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "recap": {
          "default": "",
          "title": "Recap",
          "type": "string"
        }
      },
      "required": [
        "lang",
        "chapters",
        "glossary"
      ],
      "title": "OutlineState",
      "type": "object"
    },
    "SlideNote": {
      "additionalProperties": false,
      "properties": {
        "at_ms": {
          "description": "Media time when the slide appeared",
          "minimum": 0,
          "title": "At Ms",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "id": {
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "at_ms",
        "description"
      ],
      "title": "SlideNote",
      "type": "object"
    },
    "SlidesState": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "slides",
          "default": "slides",
          "title": "Kind",
          "type": "string"
        },
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "slides": {
          "items": {
            "$ref": "#/$defs/SlideNote"
          },
          "title": "Slides",
          "type": "array"
        }
      },
      "required": [
        "lang",
        "slides"
      ],
      "title": "SlidesState",
      "type": "object"
    },
    "TranslatedLine": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "default": 0,
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "id": {
          "description": "The source caption line's id",
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "start_ms": {
          "default": 0,
          "description": "The source line's media times",
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "TranslatedLine",
      "type": "object"
    },
    "TranslationState": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "translation",
          "default": "translation",
          "title": "Kind",
          "type": "string"
        },
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/TranslatedLine"
          },
          "title": "Lines",
          "type": "array"
        }
      },
      "required": [
        "lang",
        "lines"
      ],
      "title": "TranslationState",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "Cumulative model usage of this agent process: the load panel shows cost per track, not per viewer.",
      "properties": {
        "cost_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "requests": {
          "default": 0,
          "minimum": 0,
          "title": "Requests",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One state change of one agent, as a line of ``agents/<agent>.jsonl``.",
  "properties": {
    "instance": {
      "description": "The agent instance that published it; empty under a stable name",
      "title": "Instance",
      "type": "string"
    },
    "media_ms": {
      "description": "Teacher media time when the snapshot arrived at the recorder (room ms with room_origin_ms)",
      "minimum": 0,
      "title": "Media Ms",
      "type": "integer"
    },
    "seq": {
      "description": "Its sequence number within that instance, or within the recording",
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "state": {
      "discriminator": {
        "mapping": {
          "captions": "#/$defs/CaptionsState",
          "outline": "#/$defs/OutlineState",
          "slides": "#/$defs/SlidesState",
          "translation": "#/$defs/TranslationState"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CaptionsState"
        },
        {
          "$ref": "#/$defs/TranslationState"
        },
        {
          "$ref": "#/$defs/SlidesState"
        },
        {
          "$ref": "#/$defs/OutlineState"
        }
      ],
      "title": "State"
    },
    "usage": {
      "$ref": "#/$defs/Usage",
      "description": "The instance's cumulative model usage at that moment"
    },
    "wall_ms": {
      "description": "Wall-clock time when the snapshot arrived at the recorder",
      "minimum": 0,
      "title": "Wall Ms",
      "type": "integer"
    }
  },
  "required": [
    "media_ms",
    "wall_ms",
    "instance",
    "seq",
    "usage",
    "state"
  ],
  "title": "RecordedSnapshot",
  "type": "object"
}
