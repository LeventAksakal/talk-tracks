{
  "$defs": {
    "DeckImage": {
      "additionalProperties": false,
      "properties": {
        "data_b64": {
          "minLength": 1,
          "title": "Data B64",
          "type": "string"
        },
        "height": {
          "description": "Pixels",
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "index": {
          "description": "The slide's 0-based position in its deck",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "const": "image",
          "default": "image",
          "title": "Kind",
          "type": "string"
        },
        "mime": {
          "enum": [
            "image/webp",
            "image/jpeg",
            "image/png"
          ],
          "title": "Mime",
          "type": "string"
        },
        "runs": {
          "description": "The slide's text layer in reading order, which text marks and comment anchors address; empty for a slide without text",
          "items": {
            "$ref": "#/$defs/TextRun"
          },
          "title": "Runs",
          "type": "array"
        },
        "width": {
          "description": "Pixels",
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "index",
        "mime",
        "width",
        "height",
        "data_b64"
      ],
      "title": "DeckImage",
      "type": "object"
    },
    "DeckInfo": {
      "additionalProperties": false,
      "properties": {
        "aspect": {
          "description": "Slide width / height, for layout before the images arrive",
          "exclusiveMinimum": 0,
          "title": "Aspect",
          "type": "number"
        },
        "count": {
          "description": "Number of slides",
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "kind": {
          "const": "deck",
          "default": "deck",
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The deck's title, if the speaker gave one",
          "title": "Title"
        }
      },
      "required": [
        "count",
        "aspect"
      ],
      "title": "DeckInfo",
      "type": "object"
    },
    "DeckRecord": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "discriminator": {
            "mapping": {
              "deck": "#/$defs/DeckInfo",
              "image": "#/$defs/DeckImage"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DeckInfo"
            },
            {
              "$ref": "#/$defs/DeckImage"
            }
          ],
          "title": "Data"
        },
        "m": {
          "description": "Room ms when the deck was loaded or the image sent",
          "minimum": 0,
          "title": "M",
          "type": "integer"
        }
      },
      "required": [
        "m",
        "data"
      ],
      "title": "DeckRecord",
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "description": "A box on the slide, in fractions of it: x, y the top-left corner.",
      "properties": {
        "h": {
          "maximum": 1,
          "minimum": 0,
          "title": "H",
          "type": "number"
        },
        "w": {
          "maximum": 1,
          "minimum": 0,
          "title": "W",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "Region",
      "type": "object"
    },
    "TextRun": {
      "additionalProperties": false,
      "description": "A run of the slide's text layer (a word or a line of one style, from the PDF's text content), so text marks and\ncomment anchors can address it: 'underline slide 13, run t23'.",
      "properties": {
        "box": {
          "$ref": "#/$defs/Region",
          "description": "Where the run sits on the slide; a part of a run is placed by character count"
        },
        "id": {
          "description": "Unique within its slide, e.g. t23",
          "maxLength": 32,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "box"
      ],
      "title": "TextRun",
      "type": "object"
    }
  },
  "description": "One object of the ``deck`` track (eventType ``com.talktracks.deck``).",
  "items": {
    "$ref": "#/$defs/DeckRecord"
  },
  "title": "DeckObject",
  "type": "array"
}
