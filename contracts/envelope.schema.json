{
  "$defs": {
    "AgentInfo": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "What a viewer sees in the track list",
          "title": "Label",
          "type": "string"
        },
        "model": {
          "description": "Which model does the work, or 'none'",
          "title": "Model",
          "type": "string"
        },
        "name": {
          "description": "Stable agent name, for example captions or translate-tr",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "model"
      ],
      "title": "AgentInfo",
      "type": "object"
    },
    "CaptionItem": {
      "additionalProperties": false,
      "properties": {
        "final": {
          "description": "False for an interim version; a later item with the same id replaces it",
          "title": "Final",
          "type": "boolean"
        },
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/CaptionLine"
        },
        "type": {
          "const": "caption",
          "default": "caption",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "lang",
        "line",
        "final"
      ],
      "title": "CaptionItem",
      "type": "object"
    },
    "CaptionLine": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "id": {
          "description": "Rises with time: the start time in media ms (or one more than the previous id); stable across restarts and back-fill",
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "start_ms": {
          "description": "Media time of the first word",
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start_ms",
        "end_ms",
        "text"
      ],
      "title": "CaptionLine",
      "type": "object"
    },
    "CaptionsCarry": {
      "additionalProperties": false,
      "properties": {
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "lines": {
          "description": "The last final lines before the slice",
          "items": {
            "$ref": "#/$defs/CaptionLine"
          },
          "maxItems": 2,
          "title": "Lines",
          "type": "array"
        },
        "type": {
          "const": "captions-carry",
          "default": "captions-carry",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "lang",
        "lines"
      ],
      "title": "CaptionsCarry",
      "type": "object"
    },
    "Chapter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start_ms",
        "title",
        "summary"
      ],
      "title": "Chapter",
      "type": "object"
    },
    "GlossaryTerm": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "term": {
          "title": "Term",
          "type": "string"
        }
      },
      "required": [
        "term",
        "definition"
      ],
      "title": "GlossaryTerm",
      "type": "object"
    },
    "OutlineSnapshot": {
      "additionalProperties": false,
      "description": "One revision of the whole outline: chapters, glossary and recap are revised together, never sliced.",
      "properties": {
        "chapters": {
          "items": {
            "$ref": "#/$defs/Chapter"
          },
          "title": "Chapters",
          "type": "array"
        },
        "glossary": {
          "items": {
            "$ref": "#/$defs/GlossaryTerm"
          },
          "title": "Glossary",
          "type": "array"
        },
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "recap": {
          "default": "",
          "title": "Recap",
          "type": "string"
        },
        "type": {
          "const": "outline",
          "default": "outline",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "lang",
        "chapters",
        "glossary"
      ],
      "title": "OutlineSnapshot",
      "type": "object"
    },
    "SlideItem": {
      "additionalProperties": false,
      "properties": {
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "slide": {
          "$ref": "#/$defs/SlideNote"
        },
        "type": {
          "const": "slide",
          "default": "slide",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "lang",
        "slide"
      ],
      "title": "SlideItem",
      "type": "object"
    },
    "SlideNote": {
      "additionalProperties": false,
      "properties": {
        "at_ms": {
          "description": "Media time when the slide appeared",
          "minimum": 0,
          "title": "At Ms",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "id": {
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "at_ms",
        "description"
      ],
      "title": "SlideNote",
      "type": "object"
    },
    "SlidesCarry": {
      "additionalProperties": false,
      "properties": {
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "slide": {
          "anyOf": [
            {
              "$ref": "#/$defs/SlideNote"
            },
            {
              "type": "null"
            }
          ],
          "description": "The slide on screen when the slice starts, if any"
        },
        "type": {
          "const": "slides-carry",
          "default": "slides-carry",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "lang",
        "slide"
      ],
      "title": "SlidesCarry",
      "type": "object"
    },
    "TranslatedLine": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "default": 0,
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "id": {
          "description": "The source caption line's id",
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "start_ms": {
          "default": 0,
          "description": "The source line's media times",
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "TranslatedLine",
      "type": "object"
    },
    "TranslationCarry": {
      "additionalProperties": false,
      "properties": {
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "lines": {
          "description": "The last lines before the slice",
          "items": {
            "$ref": "#/$defs/TranslatedLine"
          },
          "maxItems": 2,
          "title": "Lines",
          "type": "array"
        },
        "type": {
          "const": "translation-carry",
          "default": "translation-carry",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "lang",
        "lines"
      ],
      "title": "TranslationCarry",
      "type": "object"
    },
    "TranslationItem": {
      "additionalProperties": false,
      "properties": {
        "lang": {
          "title": "Lang",
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/TranslatedLine"
        },
        "type": {
          "const": "translation",
          "default": "translation",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "lang",
        "line"
      ],
      "title": "TranslationItem",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "Cumulative model usage of this agent process: the load panel shows cost per track, not per viewer.",
      "properties": {
        "cost_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "requests": {
          "default": 0,
          "minimum": 0,
          "title": "Requests",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One object. ``kind`` says where it sits: object 0 of a slice (``carry``), a later one (``item``), or the only\nobject of an outline revision (``snapshot``).",
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentInfo"
    },
    "at_ms": {
      "description": "Wall-clock time of publication",
      "minimum": 0,
      "title": "At Ms",
      "type": "integer"
    },
    "body": {
      "discriminator": {
        "mapping": {
          "caption": "#/$defs/CaptionItem",
          "captions-carry": "#/$defs/CaptionsCarry",
          "outline": "#/$defs/OutlineSnapshot",
          "slide": "#/$defs/SlideItem",
          "slides-carry": "#/$defs/SlidesCarry",
          "translation": "#/$defs/TranslationItem",
          "translation-carry": "#/$defs/TranslationCarry"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CaptionsCarry"
        },
        {
          "$ref": "#/$defs/TranslationCarry"
        },
        {
          "$ref": "#/$defs/SlidesCarry"
        },
        {
          "$ref": "#/$defs/CaptionItem"
        },
        {
          "$ref": "#/$defs/TranslationItem"
        },
        {
          "$ref": "#/$defs/SlideItem"
        },
        {
          "$ref": "#/$defs/OutlineSnapshot"
        }
      ],
      "title": "Body"
    },
    "capped": {
      "default": false,
      "description": "On a carry-in: the room reached its spend cap, so no items follow in this slice",
      "title": "Capped",
      "type": "boolean"
    },
    "kind": {
      "enum": [
        "carry",
        "item",
        "snapshot"
      ],
      "title": "Kind",
      "type": "string"
    },
    "slice": {
      "description": "The group: media time [slice * 4 s, (slice + 1) * 4 s); for the outline, of the revision",
      "minimum": 0,
      "title": "Slice",
      "type": "integer"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "v": {
      "const": 2,
      "default": 2,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "agent",
    "slice",
    "kind",
    "at_ms",
    "usage",
    "body"
  ],
  "title": "Envelope",
  "type": "object"
}
