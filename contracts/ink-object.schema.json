{
  "$defs": {
    "Author": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable for one person in the room: given by the room service (listeners) or the console (speaker)",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Display name, no account",
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "speaker": {
          "default": false,
          "description": "The speaker: may erase, unmark or hide anyone's annotations",
          "title": "Speaker",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Author",
      "type": "object"
    },
    "InkBegin": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "$ref": "#/$defs/Author"
        },
        "color": {
          "description": "#rrggbb",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "deck": {
          "description": "The deck track's group that holds the deck",
          "minimum": 0,
          "title": "Deck",
          "type": "integer"
        },
        "index": {
          "description": "The slide's 0-based position in its deck",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "const": "begin",
          "default": "begin",
          "title": "Kind",
          "type": "string"
        },
        "points": {
          "description": "[x, y] fractions of the slide, in drawing order",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "stroke": {
          "description": "Unique in the room, stable across re-sends; the room service prefixes a listener's with their id",
          "minLength": 1,
          "title": "Stroke",
          "type": "string"
        },
        "tool": {
          "enum": [
            "pen",
            "highlighter"
          ],
          "title": "Tool",
          "type": "string"
        },
        "width": {
          "description": "Line width as a fraction of the slide's width",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "stroke",
        "deck",
        "index",
        "tool",
        "color",
        "width",
        "points",
        "by"
      ],
      "title": "InkBegin",
      "type": "object"
    },
    "InkClear": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "$ref": "#/$defs/Author"
        },
        "deck": {
          "description": "The deck track's group that holds the deck",
          "minimum": 0,
          "title": "Deck",
          "type": "integer"
        },
        "index": {
          "description": "The slide's 0-based position in its deck",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "const": "clear",
          "default": "clear",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "deck",
        "index",
        "by"
      ],
      "title": "InkClear",
      "type": "object"
    },
    "InkEnd": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "end",
          "default": "end",
          "title": "Kind",
          "type": "string"
        },
        "stroke": {
          "description": "Unique in the room, stable across re-sends; the room service prefixes a listener's with their id",
          "minLength": 1,
          "title": "Stroke",
          "type": "string"
        }
      },
      "required": [
        "stroke"
      ],
      "title": "InkEnd",
      "type": "object"
    },
    "InkErase": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "$ref": "#/$defs/Author"
        },
        "kind": {
          "const": "erase",
          "default": "erase",
          "title": "Kind",
          "type": "string"
        },
        "strokes": {
          "description": "Ids of strokes or shapes",
          "items": {
            "description": "Unique in the room, stable across re-sends; the room service prefixes a listener's with their id",
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Strokes",
          "type": "array"
        }
      },
      "required": [
        "strokes",
        "by"
      ],
      "title": "InkErase",
      "type": "object"
    },
    "InkPoints": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "points",
          "default": "points",
          "title": "Kind",
          "type": "string"
        },
        "points": {
          "description": "[x, y] fractions of the slide, in drawing order",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "stroke": {
          "description": "Unique in the room, stable across re-sends; the room service prefixes a listener's with their id",
          "minLength": 1,
          "title": "Stroke",
          "type": "string"
        }
      },
      "required": [
        "stroke",
        "points"
      ],
      "title": "InkPoints",
      "type": "object"
    },
    "InkRecord": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "discriminator": {
            "mapping": {
              "begin": "#/$defs/InkBegin",
              "clear": "#/$defs/InkClear",
              "end": "#/$defs/InkEnd",
              "erase": "#/$defs/InkErase",
              "points": "#/$defs/InkPoints",
              "shape": "#/$defs/InkShape",
              "stroke": "#/$defs/InkStroke"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/InkBegin"
            },
            {
              "$ref": "#/$defs/InkPoints"
            },
            {
              "$ref": "#/$defs/InkEnd"
            },
            {
              "$ref": "#/$defs/InkStroke"
            },
            {
              "$ref": "#/$defs/InkShape"
            },
            {
              "$ref": "#/$defs/InkErase"
            },
            {
              "$ref": "#/$defs/InkClear"
            }
          ],
          "title": "Data"
        },
        "m": {
          "description": "Room ms when it took effect on screen",
          "minimum": 0,
          "title": "M",
          "type": "integer"
        }
      },
      "required": [
        "m",
        "data"
      ],
      "title": "InkRecord",
      "type": "object"
    },
    "InkShape": {
      "additionalProperties": false,
      "description": "A shape, whole: a rectangle or ellipse in the box from ``start`` to ``end``, or a line or arrow from ``start``\nto ``end`` (the arrow's head).",
      "properties": {
        "by": {
          "$ref": "#/$defs/Author"
        },
        "color": {
          "description": "#rrggbb",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "deck": {
          "description": "The deck track's group that holds the deck",
          "minimum": 0,
          "title": "Deck",
          "type": "integer"
        },
        "end": {
          "description": "Where it ended: the opposite corner, or the arrow's head",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          ],
          "title": "End",
          "type": "array"
        },
        "index": {
          "description": "The slide's 0-based position in its deck",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "const": "shape",
          "default": "shape",
          "title": "Kind",
          "type": "string"
        },
        "shape": {
          "enum": [
            "rect",
            "ellipse",
            "line",
            "arrow"
          ],
          "title": "Shape",
          "type": "string"
        },
        "start": {
          "description": "Where the drag began",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          ],
          "title": "Start",
          "type": "array"
        },
        "stroke": {
          "description": "Unique in the room, stable across re-sends; the room service prefixes a listener's with their id",
          "minLength": 1,
          "title": "Stroke",
          "type": "string"
        },
        "width": {
          "description": "Line width as a fraction of the slide's width",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "stroke",
        "deck",
        "index",
        "shape",
        "start",
        "end",
        "color",
        "width",
        "by"
      ],
      "title": "InkShape",
      "type": "object"
    },
    "InkStroke": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "$ref": "#/$defs/Author"
        },
        "color": {
          "description": "#rrggbb",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "deck": {
          "description": "The deck track's group that holds the deck",
          "minimum": 0,
          "title": "Deck",
          "type": "integer"
        },
        "done": {
          "description": "False while its author is still drawing it: points and end follow",
          "title": "Done",
          "type": "boolean"
        },
        "index": {
          "description": "The slide's 0-based position in its deck",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "const": "stroke",
          "default": "stroke",
          "title": "Kind",
          "type": "string"
        },
        "points": {
          "description": "[x, y] fractions of the slide, in drawing order",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "stroke": {
          "description": "Unique in the room, stable across re-sends; the room service prefixes a listener's with their id",
          "minLength": 1,
          "title": "Stroke",
          "type": "string"
        },
        "tool": {
          "enum": [
            "pen",
            "highlighter"
          ],
          "title": "Tool",
          "type": "string"
        },
        "width": {
          "description": "Line width as a fraction of the slide's width",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "stroke",
        "deck",
        "index",
        "tool",
        "color",
        "width",
        "points",
        "by",
        "done"
      ],
      "title": "InkStroke",
      "type": "object"
    }
  },
  "description": "One object of an ``ink`` track (eventType ``com.talktracks.ink``): the speaker's or the room service's.",
  "items": {
    "$ref": "#/$defs/InkRecord"
  },
  "title": "InkObject",
  "type": "array"
}
